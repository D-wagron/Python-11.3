{
  "name": "Python-11.3",
  "image": "://microsoft.com",
  
  "updateContentCommand": "pip install -r requirements.txt || echo 'No requirements.txt found'",
  
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  },

  "postAttachCommand": "python3 menu.py"
}
